{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:allow-join",
    "dialog:allow-open",
    "fs:allow-mkdir",
    "fs:allow-stat",
    "upload:allow-download",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    }
  ]
}
