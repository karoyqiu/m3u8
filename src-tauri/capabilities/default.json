{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:path:allow-join",
    "dialog:allow-open",
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-remove",
    "fs:allow-rename",
    "fs:allow-write-text-file",
    "shell:allow-kill",
    "upload:allow-download",
    {
      "identifier": "http:default",
      "allow": [{ "url": "https://*" }]
    },
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "sidecar": true,
          "name": "binaries/ffmpeg",
          "args": [
            "-y",
            "-progress",
            "pipe:1",
            "-nostats",
            "-loglevel",
            "error",
            "-f",
            "concat",
            "-i",
            {
              "validator": ".+"
            },
            "-c",
            "copy",
            {
              "validator": ".+"
            }
          ]
        }
      ]
    }
  ]
}
