{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "m3u8",
  "identifier": "com.gmail.karoyqiu.m3u8",
  "build": {
    "beforeDevCommand": "yarn dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "yarn build",
    "frontendDist": "../dist",
    "removeUnusedCommands": true
  },
  "app": {
    "windows": [
      {
        "title": "m3u8",
        "center": true,
        "visible": false,
        "width": 560,
        "height": 960,
        "useHttpsScheme": true
      }
    ],
    "security": {
      "csp": {
        "default-src": ["'self'"],
        "connect-src": ["'self'", "ipc:", "http://ipc.localhost", "https://ipc.localhost"],
        "img-src": ["'self'", "https:", "data:"],
        "style-src": [
          "'self'",
          "'sha256-47DEQpj8HBSa+/TImW+5JCeuQeRkm5NMpJWZG3hSuFU='",
          "'sha256-CIxDM5jnsGiKqXs2v7NKCY5MzdR9gu6TtiMJrDw29AY='",
          "'sha256-vGQdhYJbTuF+M8iCn1IZCHpdkiICocWHDq4qnQF4Rjw='",
          "'nonce-huahC9gksP5zq3dBQmX97mb9m5FEyGCt'"
        ]
      }
    }
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "externalBin": ["binaries/ffmpeg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
